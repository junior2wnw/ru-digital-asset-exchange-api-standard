{
  "info": {
    "name": "RU Digital Market Interoperability Profile",
    "description": "Reference Postman collection for the RU Digital Market Interoperability Profile draft.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "instrumentId",
      "value": "BTC-RUB-SPOT"
    },
    {
      "key": "apiKey",
      "value": "sandbox-key"
    },
    {
      "key": "idempotencyKey",
      "value": "demo-{{$timestamp}}"
    }
  ],
  "item": [
    {
      "name": "Discovery",
      "item": [
        {
          "name": "Server Time",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/time"
          }
        },
        {
          "name": "Venue Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/profile"
          }
        },
        {
          "name": "Instruments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/instruments"
          }
        },
        {
          "name": "Instrument",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/instruments/{{instrumentId}}"
          }
        }
      ]
    },
    {
      "name": "Market Data",
      "item": [
        {
          "name": "Order Book",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/market/orderbook?instrument_id={{instrumentId}}&depth=50"
          }
        },
        {
          "name": "Public Trades",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/market/trades?instrument_id={{instrumentId}}&limit=50"
          }
        },
        {
          "name": "Candles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/market/candles?instrument_id={{instrumentId}}&interval=1m&limit=50"
          }
        }
      ]
    },
    {
      "name": "Execution",
      "item": [
        {
          "name": "Execution Capabilities",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/execution/capabilities"
          }
        }
      ]
    },
    {
      "name": "Entitlements & Authorization",
      "item": [
        {
          "name": "Entitlement Capabilities",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/entitlements/capabilities"
          }
        },
        {
          "name": "Entitlements",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "X-Timestamp", "value": "2026-05-25T00:00:00Z" },
              { "key": "X-Signature", "value": "sandbox-signature" }
            ],
            "url": "{{baseUrl}}/v1/entitlements"
          }
        },
        {
          "name": "Evaluate Entitlement Authorization",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "X-Timestamp", "value": "2026-05-25T00:00:00Z" },
              { "key": "X-Signature", "value": "sandbox-signature" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject_ref\": \"subject_demo_hash_001\",\n  \"subject_type\": \"legal_entity\",\n  \"action\": \"transfer\",\n  \"resource_ref\": \"entitlement_demo_cfa_holding_1\",\n  \"purpose\": \"pilot_transfer_check\",\n  \"authentication_assurance\": \"high\",\n  \"scopes\": [\"entitlements.transfer\"],\n  \"requested_at\": \"2026-05-25T00:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/v1/entitlements/authorization/evaluate"
          }
        }
      ]
    },
    {
      "name": "Trading",
      "item": [
        {
          "name": "Balances",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": "{{baseUrl}}/v1/account/balances"
          }
        },
        {
          "name": "Create Limit Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "X-Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instrument_id\": \"{{instrumentId}}\",\n  \"side\": \"buy\",\n  \"type\": \"limit\",\n  \"quantity\": \"0.01\",\n  \"price\": \"5000000\",\n  \"time_in_force\": \"gtc\",\n  \"client_order_id\": \"postman-{{$timestamp}}\"\n}"
            },
            "url": "{{baseUrl}}/v1/orders"
          }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": "{{baseUrl}}/v1/orders"
          }
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Wallet Assets",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": "{{baseUrl}}/v1/wallet/assets"
          }
        },
        {
          "name": "Create Deposit Address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "X-Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_id\": \"USDT\",\n  \"network_id\": \"TRON\"\n}"
            },
            "url": "{{baseUrl}}/v1/wallet/deposit-addresses"
          }
        },
        {
          "name": "Create Withdrawal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "X-Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_id\": \"USDT\",\n  \"network_id\": \"TRON\",\n  \"amount\": \"10\",\n  \"address\": \"TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\"\n}"
            },
            "url": "{{baseUrl}}/v1/wallet/withdrawals"
          }
        }
      ]
    },
    {
      "name": "Compliance & Reporting",
      "item": [
        {
          "name": "Compliance Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": "{{baseUrl}}/v1/compliance/profile"
          }
        },
        {
          "name": "Consents",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": "{{baseUrl}}/v1/compliance/consents"
          }
        },
        {
          "name": "Audit Events",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": "{{baseUrl}}/v1/compliance/audit-events?limit=50"
          }
        },
        {
          "name": "Regulatory Reports",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": "{{baseUrl}}/v1/reports/regulatory"
          }
        }
      ]
    }
  ]
}
