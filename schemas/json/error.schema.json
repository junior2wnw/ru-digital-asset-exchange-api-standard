{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ru-dmip:schema:error:0.1",
  "title": "ErrorEnvelope",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message", "category", "request_id"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "message": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "validation",
            "authentication",
            "authorization",
            "rate_limit",
            "business",
            "risk",
            "compliance",
            "not_found",
            "conflict",
            "system"
          ]
        },
        "request_id": { "type": "string" },
        "details": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
